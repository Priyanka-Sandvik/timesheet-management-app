TASKS_TABLE_NAME=Tasks
PROFILE_SERVICE_BASE_URL=http://localhost:8001

# USE_LOCAL_KEY=true fetches Profile Service's JWKS_URL to verify tokens. In production,
# set USE_LOCAL_KEY=false and populate KEY_VAULT_URL + the two JWT_*_SECRET_NAME vars below
# to read the public key + kid directly from Key Vault instead (no JWKS endpoint call).
USE_LOCAL_KEY=true
JWKS_URL=http://localhost:8001/.well-known/jwks.json
KEY_VAULT_URL=
JWT_PUBLIC_KEY_SECRET_NAME=jwt-public-key
JWT_KID_SECRET_NAME=jwt-kid

CORS_ALLOWED_ORIGIN=
# Used in every environment, including production (see py_common.core.table_client) — there
# is no Managed Identity / account-URL path.
AZURE_STORAGE_CONNECTION_STRING=
PORT=8002

# --- Extra local-dev / behavior-tuning vars (not in architecture doc §11 table) ---
JWT_ISSUER=profile-service
VALIDATE_ASSIGN_EMAILS_WITH_PROFILE_SERVICE=true
PROFILE_SERVICE_TIMEOUT_SECONDS=5.0
DEFAULT_ADMIN_LIST_PAGE_SIZE=50
