# --- Azure Table Storage (architecture doc §11) ---
AZURE_STORAGE_ACCOUNT_URL=
USERS_TABLE_NAME=Users
KEY_VAULT_URL=
JWT_KEY_NAME=
JWT_EXPIRY_HOURS=8
ADMIN_EMAILS=admin1@sandvik.com,admin2@sandvik.com
ALLOWED_EMAIL_DOMAIN=sandvik.com
CORS_ALLOWED_ORIGIN=https://<static-web-app-domain>
AUTH_RATE_LIMIT_PER_MINUTE=20

# --- Local-dev-only additions ---
# ENVIRONMENT gates the connection-string fallback in py_common.core.table_client:
# only "local" is permitted to use AZURE_STORAGE_CONNECTION_STRING; anything else requires
# AZURE_STORAGE_ACCOUNT_URL + DefaultAzureCredential (Managed Identity).
ENVIRONMENT=local

# Azurite well-known connection string (default dev storage emulator credentials, public/
# documented by Microsoft -- NOT a secret).
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;TableEndpoint=http://127.0.0.1:10002/devstoreaccount1;

# USE_LOCAL_KEY=true generates/loads an RSA keypair on local disk via LocalFileKeySource
# instead of Key Vault. Flip to false only once KeyVaultKeySource is implemented in
# py_common and KEY_VAULT_URL/JWT_KEY_NAME above are set.
USE_LOCAL_KEY=true
LOCAL_KEY_DIR=./.keys

PORT=8001

# Self-referential: Profile Service verifies its OWN issued tokens on GET /api/v1/me, so
# its JWKS_URL points back at itself.
JWKS_URL=http://localhost:8001/.well-known/jwks.json
