# --- Azure Table Storage (architecture doc §11) ---
USERS_TABLE_NAME=Users
KEY_VAULT_URL=
JWT_PRIVATE_KEY_SECRET_NAME=jwt-private-key
JWT_PUBLIC_KEY_SECRET_NAME=jwt-public-key
JWT_KID_SECRET_NAME=jwt-kid
JWT_EXPIRY_HOURS=8
ADMIN_EMAILS=admin1@sandvik.com,admin2@sandvik.com
ALLOWED_EMAIL_DOMAIN=sandvik.com
CORS_ALLOWED_ORIGIN=https://<static-web-app-domain>
AUTH_RATE_LIMIT_PER_MINUTE=20

# --- Local-dev-only additions ---
# AZURE_STORAGE_CONNECTION_STRING is used in every environment, including production
# (see py_common.core.table_client) — there is no Managed Identity / account-URL path.
# Below is the Azurite well-known connection string for local dev (default dev storage
# emulator credentials, public/documented by Microsoft -- NOT a secret). In production,
# set this to the real Storage Account's connection string.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;TableEndpoint=http://127.0.0.1:10002/devstoreaccount1;

# USE_LOCAL_KEY=true generates/loads an RSA keypair on local disk via LocalFileKeySource
# instead of Key Vault. In production, set USE_LOCAL_KEY=false and populate KEY_VAULT_URL
# + the three JWT_*_SECRET_NAME vars above; the private/public key and kid are then read
# directly from Key Vault secrets (via Managed Identity) for both issuing and verifying
# tokens — the /.well-known/jwks.json endpoint is not used in that mode.
USE_LOCAL_KEY=true
LOCAL_KEY_DIR=./.keys

PORT=8001

# Only used when USE_LOCAL_KEY=true. Self-referential: Profile Service verifies its OWN
# issued tokens on GET /api/v1/me, so its JWKS_URL points back at itself.
JWKS_URL=http://localhost:8001/.well-known/jwks.json
